# Root Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MySQL / Aiven Cloud MySQL)
# For local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_college_copilot
DB_SSL=false

# For Aiven Cloud MySQL:
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=25000
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_db_password
# DB_NAME=defaultdb
# DB_SSL=true
# DB_SSL_CA_PATH=./certs/ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication & AI Credentials
JWT_SECRET=production_jwt_secret_key_change_in_prod
ADMIN_SECRET=dev_admin_secret_key_2026
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_google_gemini_or_llm_api_key
STRICT_EMBEDDINGS=true
