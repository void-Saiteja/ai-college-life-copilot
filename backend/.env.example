# Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL / Aiven Cloud MySQL Configuration
# For local development:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_college_copilot
DB_SSL=false

# For Aiven Cloud MySQL:
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=25000
# DB_USER=avnadmin
# DB_PASSWORD=your_secure_aiven_password
# DB_NAME=defaultdb
# DB_SSL=true
# Optional SSL CA configuration (keep private ca.pem outside source control):
# DB_SSL_CA_PATH=./ca.pem
# DB_SSL_CA_CERT=
# DB_SSL_REJECT_UNAUTHORIZED=true

# Security & AI Configuration
JWT_SECRET=super_secret_jwt_key_2026_change_in_production
ADMIN_SECRET=dev_admin_secret_key_2026
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
STRICT_EMBEDDINGS=true
